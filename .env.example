# Local Postgres connection. Update to match your local DB or Render's
# managed Postgres connection string when deploying.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/statworkforce?schema=public"

# Used to sign session JWTs. Generate your own with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-generated-32-byte-base64-secret"

# Shared machine credential for scheduled credential and push-delivery jobs.
CRON_SECRET="replace-with-a-second-random-secret"

# Required by `npm run deploy:preflight`; use staging or production.
DEPLOYMENT_TIER="staging"

# Optional immutable release identifier for error telemetry. Render supplies
# RENDER_GIT_COMMIT automatically; other platforms can set RELEASE_SHA.
RELEASE_SHA=""

# Optional production credential-document storage. If the bucket is unset,
# local development keeps documents in Postgres for zero-configuration use.
# Use workload/instance identity in production instead of long-lived keys.
CREDENTIAL_STORAGE_BUCKET=""
AWS_REGION="us-west-2"
# For S3-compatible providers only (for AWS S3, leave these unset):
# CREDENTIAL_STORAGE_ENDPOINT="https://s3.example.com"
# CREDENTIAL_STORAGE_FORCE_PATH_STYLE="true"
